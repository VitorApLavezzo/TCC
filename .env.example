# =============================================
# AnomalyDetect — Exemplo de configuração
# Copie para .env e preencha os valores:  cp .env.example .env
# =============================================

# --- Backend / Segurança ---
# Gere uma chave forte: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-this-in-production

# --- Login com Google (opcional) ---
# Crie um Client ID OAuth em https://console.cloud.google.com/apis/credentials
# (tipo "Aplicativo da Web", origem autorizada = endereço do site). Vazio = botão oculto.
GOOGLE_CLIENT_ID=

# --- Banco de dados ---
# Usada apenas ao rodar o backend fora do Docker (no Docker o compose já define)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anomaly_db

# --- Ollama (IA local para explicações) ---
# Onde o Ollama está rodando?
#   1. Container do compose (mesma máquina, com GPU):
#      OLLAMA_BASE_URL=http://ollama:11434  e suba com: docker compose --profile local-ollama up -d
#   2. Instalado direto nesta máquina (fora do Docker):
#      OLLAMA_BASE_URL=http://host.docker.internal:11434
#   3. Em outra máquina da rede:
#      OLLAMA_BASE_URL=http://IP-DA-MAQUINA:11434  (ex: 192.168.0.15 ou IP do Tailscale)
# Se o Ollama estiver inacessível, o backend usa o fallback em nuvem automaticamente.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b

# --- Fallback de IA em nuvem (usado quando o Ollama estiver offline) ---
# Crie uma chave gratuita em https://console.groq.com/keys e cole abaixo.
# Se ficar vazia, o sistema usa apenas Ollama + análise estática local.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# --- Claude Code CLI (provedor de explicações em modo headless) ---
# Usa a assinatura já autenticada na sua máquina. Quando ativo, é o PRIMEIRO
# provedor da cadeia; o Ollama continua como fallback se o CLI falhar.
# CLAUDE_HOST_CONFIG aponta para o ~/.claude do host (montado somente-leitura).
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=120
# Windows: C:/Users/SEU-USUARIO/.claude   |   Linux/Mac: /home/seu-usuario/.claude
CLAUDE_HOST_CONFIG=./.claude-host

# --- Agente (container "agent" do docker-compose) ---
# Pareamento automático: gere um código no painel (botão "Nova Máquina") e cole aqui.
# É usado apenas uma vez — depois o agente salva o token sozinho.
AGENT_ENROLL_CODE=
# (Avançado) Token fixo — só preencha se não quiser usar o código de pareamento
AGENT_API_TOKEN=
# Intervalo de coleta em segundos.
# Definir aqui FIXA o intervalo: o agente ignora o ajuste automático do servidor
# (que aceleraria para 10s ao detectar um desvio e desaceleraria para 60s com a
# máquina parada na bateria). Deixe comentado para usar a coleta adaptativa, ou
# use AGENT_ADAPTIVE=1 junto para manter o ajuste automático mesmo com valor fixo.
COLLECTION_INTERVAL=30

# --- Detecção de anomalias (opcional) ---
# MIN_TRAINING_SAMPLES=100
# ISOLATION_FOREST_CONTAMINATION=0.03
# ML_ALERT_PERCENTILE=0.5           # fração do histórico da máquina tratada como fora do padrão
# DEFAULT_TZ_OFFSET_MINUTES=-180    # fuso usado até o agente informar o da máquina (Brasília)

# --- Notificações (tudo opcional; o painel sempre mostra os avisos) ---
# Endereço público do painel, para os links das mensagens
# PUBLIC_BASE_URL=http://192.168.0.10:3000
# Bot de Telegram: crie com o @BotFather e cole o token (usa long polling,
# funciona atrás de NAT). Vazio = Telegram desativado.
# TELEGRAM_BOT_TOKEN=
# E-mail (SMTP). Vazio = e-mail desativado.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Reputação coletiva de executáveis (opcional) ---
# Chave gratuita do VirusTotal para checar hashes raros (4 consultas/min)
# VIRUSTOTAL_API_KEY=
# Outro servidor AnomalyDetect que agrega reputação anônima entre instalações
# REPUTATION_HUB_URL=
# REPUTATION_HUB_ACCEPT=true        # este servidor aceita contribuições (atua como hub)

# --- Energia (padrões enquanto o usuário não informa os seus) ---
# DEFAULT_TARIFF_KWH=0.85           # R$ por kWh
# DEFAULT_CO2_KG_PER_KWH=0.0385     # fator médio do SIN
