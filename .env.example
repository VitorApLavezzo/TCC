# =============================================
# AnomalyDetect — Exemplo de configuração
# Copie para .env e preencha os valores:  cp .env.example .env
# =============================================

# --- Backend / Segurança ---
# Obrigatória, aleatória e com 32+ caracteres (o backend recusa valores conhecidos).
# start.sh / start.ps1 preenchem ao criar o .env. Para gerar à mão:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Senha do PostgreSQL (start.sh gera). Vazia, o compose usa "postgres" — só
# aceitável porque o banco agora escuta apenas em 127.0.0.1.
POSTGRES_PASSWORD=

# --- Login com Google (opcional) ---
# Crie um Client ID OAuth em https://console.cloud.google.com/apis/credentials
# (tipo "Aplicativo da Web", origem autorizada = endereço do site). Vazio = botão oculto.
GOOGLE_CLIENT_ID=

# --- Banco de dados ---
# Usada apenas ao rodar o backend fora do Docker (no Docker o compose já define)
# (a senha é a mesma de POSTGRES_PASSWORD)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/anomaly_db

# --- Ollama (IA local para explicações) ---
# Onde o Ollama está rodando?
#   1. Container do compose (mesma máquina, com GPU):
#      OLLAMA_BASE_URL=http://ollama:11434  e suba com: docker compose --profile local-ollama up -d
#   2. Instalado direto nesta máquina (fora do Docker):
#      OLLAMA_BASE_URL=http://host.docker.internal:11434
#      ATENÇÃO: por padrão o Ollama escuta só em 127.0.0.1, e o container não o
#      alcança (dá "Connection refused"). Rode-o com OLLAMA_HOST=0.0.0.0.
#   3. Em outra máquina da rede (ex: o PC com GPU):
#      OLLAMA_BASE_URL=http://IP-DA-MAQUINA:11434  (ex: 192.168.0.15 ou IP do Tailscale)
#      e, naquela máquina, OLLAMA_HOST=0.0.0.0 + porta 11434 liberada no firewall.
# Se o Ollama estiver inacessível, a cadeia segue para o Claude pela CLI.
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:14b
#   Túnel com usuário e senha na frente do Ollama (ex.: ngrok com basic auth):
#      OLLAMA_BASE_URL=https://seu-tunel.ngrok-free.dev
#      OLLAMA_USERNAME=usuario
#      OLLAMA_PASSWORD=senha
# Ordem das IAs: true = Ollama primeiro; false = nuvem (Claude) primeiro e Ollama de reserva
LLM_LOCAL_FIRST=true

# --- API de IA compatível com OpenAI (opcional, entra depois do Claude) ---
# Ex: chave gratuita em https://console.groq.com/keys. Vazia, fica de fora.
CLOUD_LLM_API_KEY=
CLOUD_LLM_BASE_URL=https://api.groq.com/openai/v1
CLOUD_LLM_MODEL=llama-3.3-70b-versatile

# --- Claude Code CLI (provedor de explicações em modo headless) ---
# Usa a sua assinatura (sem chave de API). Por padrão entra DEPOIS do Ollama na
# cadeia (veja LLM_LOCAL_FIRST). Roda só gerando texto — sem ferramentas, MCP,
# plugins nem hooks.
# Recomendado: um login só do servidor. Rode `claude setup-token` no computador e
# cole o token em CLAUDE_CODE_OAUTH_TOKEN. Sem ele, o backend copia o login do
# computador (CLAUDE_HOST_CONFIG), e os dois renovando o mesmo login derrubam um
# ao outro quando o computador fica horas sem usar o Claude Code.
CLAUDE_CLI_ENABLED=false
CLAUDE_CLI_MODEL=sonnet
CLAUDE_CLI_TIMEOUT=120
CLAUDE_CODE_OAUTH_TOKEN=
# Windows: C:/Users/SEU-USUARIO/.claude   |   Linux/Mac: /home/seu-usuario/.claude
CLAUDE_HOST_CONFIG=./.claude-host

# --- Agente (container "agent" do docker-compose) ---
# Pareamento automático: gere um código no painel (botão "Nova Máquina") e cole aqui.
# É usado apenas uma vez — depois o agente salva o token sozinho.
AGENT_ENROLL_CODE=
# (Avançado) Token fixo — só preencha se não quiser usar o código de pareamento
AGENT_API_TOKEN=
# Intervalo de coleta em segundos.
# Definir aqui FIXA o intervalo: o agente ignora o ajuste automático do servidor
# (que aceleraria para 10s ao detectar um desvio e desaceleraria para 60s com a
# máquina parada na bateria). Deixe comentado para usar a coleta adaptativa, ou
# use AGENT_ADAPTIVE=1 junto para manter o ajuste automático mesmo com valor fixo.
COLLECTION_INTERVAL=30

# --- Detecção de anomalias (opcional) ---
# MIN_TRAINING_SAMPLES=100
# ISOLATION_FOREST_CONTAMINATION=0.03
# ML_ALERT_PERCENTILE=1.0           # fração do histórico da máquina tratada como fora do padrão
# ML_SVM_CONFIRM=false              # exige que o One-Class SVM concorde com o Isolation Forest
# DEFAULT_TZ_OFFSET_MINUTES=-180    # fuso usado até o agente informar o da máquina (Brasília)

# --- Notificações (tudo opcional; o painel sempre mostra os avisos) ---
# Endereço público do painel, para os links das mensagens
# PUBLIC_BASE_URL=http://192.168.0.10:3000
# Bot de Telegram: crie com o @BotFather e cole o token (usa long polling,
# funciona atrás de NAT). Vazio = Telegram desativado.
# TELEGRAM_BOT_TOKEN=
# E-mail (SMTP). Vazio = e-mail desativado.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# --- Reputação coletiva de executáveis (opcional) ---
# Chave gratuita do VirusTotal para checar hashes raros (4 consultas/min)
# VIRUSTOTAL_API_KEY=
# Outro servidor AnomalyDetect que agrega reputação anônima entre instalações
# REPUTATION_HUB_URL=
# REPUTATION_HUB_ACCEPT=true        # este servidor aceita contribuições (atua como hub)

# --- Energia (padrões enquanto o usuário não informa os seus) ---
# DEFAULT_TARIFF_KWH=0.85           # R$ por kWh
# DEFAULT_CO2_KG_PER_KWH=0.0385     # fator médio do SIN

# --- Segurança da API ---
# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
# "*" (padrão) libera qualquer uma e desliga credenciais de origem cruzada — o
# painel autentica por Bearer, então nada se perde. Em produção, feche a lista:
# ALLOWED_ORIGINS=https://painel.suaempresa.com.br
# Limite de tentativas por IP em login, cadastro e pareamento
# RATE_LIMIT_ENABLED=true

# --- Avisos no celular (Web Push, opcional) ---
# Gere o par uma única vez, com o sistema no ar:
#   docker compose exec backend python -m app.services.push
# Cole as duas chaves aqui e reinicie o backend. Vazio = canal desativado.
#
# ATENÇÃO: o navegador só oferece notificação em segundo plano (e instalação
# pela tela inicial) em conexão segura. Servido por HTTP num IP de rede local
# — http://192.168.x.x:3000 — nem o Chrome no Android nem o Safari no iPhone
# expõem o recurso; localhost é a única exceção. Para usar no celular, publique
# atrás de um proxy com certificado (Caddy/Nginx + Let's Encrypt) ou use um
# túnel HTTPS. Telegram e e-mail funcionam sem isso.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_CONTACT_EMAIL=voce@exemplo.com

# --- Deriva do modelo (opcional) ---
# Distância a partir da qual o normal aprendido não descreve mais a máquina
# DRIFT_WARN=0.20
# DRIFT_CRITICAL=0.35
# DRIFT_RECENT_SAMPLES=300

# --- Automações (playbooks) ---
# Janela de arrependimento: uma ação automática é anunciada e só acontece
# depois deste tempo, para dar chance de cancelar
# PLAYBOOK_UNDO_SECONDS=120
# Teto de execuções automáticas por regra a cada 24 h
# PLAYBOOK_DAILY_LIMIT=10
